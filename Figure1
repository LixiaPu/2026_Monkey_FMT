library(dplyr)
#
taxonomy <- read.csv ("Final_gtdbtk.taxonmy.csv", header = TRUE, sep = ",",row.names = 1)
#1603 complete >80 <10
taxonomy_data<-as.data.frame(taxonomy)
taxonomy_data$MAG<-row.names(taxonomy_data)
taxonomy_counts <- taxonomy_data %>%
  summarise(across(Phylum:MAG, ~n_distinct(.))) %>%
  pivot_longer(cols = everything(), names_to = "Taxonomic_Level", values_to = "Count")
#
taxonomy_counts$Taxonomic_Level <- factor(
  taxonomy_counts$Taxonomic_Level,
  levels = c("Phylum", "Class", "Order", "Family", "Genus", "Species", "MAG"),labels = c("Phylum", "Class", "Order", "Family", "Genus", "Species", "MAGs"))
# 绘制柱状图
library("RColorBrewer")
colors<-c("#d73027","#f46d43","#fdae61","#fee090","#e0f3f8","#abd9e9","#74add1","#4575b4")
p <- ggplot(taxonomy_counts, aes(x = Taxonomic_Level, y = Count, fill = Taxonomic_Level)) +
  geom_bar(stat = "identity", color = "black", width = 0.7,alpha=0.8) +  # 黑色边框
  geom_text(aes(label = Count), vjust = -0.5, size = 6, fontface = "bold") +  # 显示数值标签
  scale_fill_manual(values = colors) +  # 使用自定义颜色
  labs(title = "No. of taxa", x = "", y = "Count") +
  theme(legend.key=element_blank())+
  theme_bw()+
  theme(panel.grid = element_blank(),
        axis.text.x = element_text(angle = 0, hjust = 0.5, vjust = 1.5, size = 14, face = "bold", color = "black"),  # x轴标签
        axis.text.y = element_text(size = 14, face = "bold", color = "black"),
        axis.title = element_text(size = 16, face = "bold"),
        plot.title = element_text(hjust = 0.5, face = "bold"),
        plot.subtitle = element_text(hjust = 0.5, face = "italic"),
        legend.position = "none")
ggsave("FigureS1a.pdf",width = 6,height = 6)
