tree<-read.csv("../Tables/tree.csv")
tax<-read.csv("../Tables/taxonomy_ra.csv")
tree_used<-left_join(tax,tree,by="MAGs")
#
df <- tree_used %>%
  mutate(Quality = case_when(
    Completeness >= 97 & Contamination <= 0 ~ "Near complete",
    Completeness >= 90 & Contamination <= 5 ~ "High quality",
    Completeness >= 80 & Contamination <= 10 ~ "Medium quality",
    TRUE ~ "Other"
  ))
#
mypal = cbbPalette<-c("#b2182b","#2166ac","#d1e5f0")
ggplot(df, aes(x = Completeness, y = Contamination, color = Quality)) +
  geom_point(size = 2) +
  scale_color_manual(values = mypal) +
  theme_minimal(base_size = 16) +
  labs(title = "",
       x = "Completeness (%)",
       y = "Contamination (%)") +
  theme_bw()+
  theme(panel.grid = element_blank(),
        axis.text.x = element_text(angle = 0, hjust = 0.5, vjust = 1.5, size = 14, face = "bold", color = "black"),  # x轴标签
        axis.text.y = element_text(size = 14, face = "bold", color = "black"),
        axis.title = element_text(size = 16, face = "bold"),
        plot.title = element_text(hjust = 0.5, face = "bold"),
        plot.subtitle = element_text(hjust = 0.5, face = "italic"))
